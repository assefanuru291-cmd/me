{
  "name": "material-managemnt-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && node server.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build": "vite build",
    "lint": "eslint .",
    "check:i18n": "node scripts/check-i18n.mjs && node scripts/check-i18n-dynamic.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check": "npm run lint && npm run check:i18n && npm run check:routes && npm --prefix backend run check",
    "test": "npm run test:frontend && npm --prefix backend test",
    "test:frontend": "node --test tests/",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
